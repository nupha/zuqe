    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'zuqe'",
            "preLaunchTask": "cargo build bin zuqe",
            "program": "${workspaceFolder}/target/debug/zuqe",
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug example 'zjs'",
            "preLaunchTask": "cargo build example zjs",
            "program": "${workspaceFolder}/target/debug/examples/zjs",
            "args": [
                "${workspaceFolder}/tests/debug.js"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug example 'zjs' esm",
            "preLaunchTask": "cargo build example zjs",
            "program": "${workspaceFolder}/target/debug/examples/zjs",
            "args": [
                "${workspaceFolder}/tests/debug.mjs"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug example 'zjs' microbench",
            "preLaunchTask": "cargo build example zjs",
            "program": "${workspaceFolder}/target/debug/examples/zjs",
            "args": [
                "${workspaceFolder}/tests/microbench.js",
                // "string_build2"
                "sort_bench"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug example 'zjs' repl",
            "preLaunchTask": "cargo build example zjs",
            "program": "${workspaceFolder}/target/debug/examples/zjs",
            "args": [
                "-m",
                "${workspaceFolder}/scripts/repl.js"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug example 'test262'",
            "preLaunchTask": "cargo build example test262",
            "program": "${workspaceFolder}/target/debug/examples/test262",
            "args": [
                "--config",
                "test262.yml",
                "--preset",
                "ES2023"
            ],
            "env": {
                "RUST_BACKTRACE": "1"
            },
            "cwd": "${workspaceFolder}"
        },
    ]
